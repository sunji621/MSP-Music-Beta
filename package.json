{
  "name": "msp-music-beta",
  "version": "26.11.9-Beta",
  "description": "Local Electron Music Player with ID3/LRC/MusicBrainz integration",
  "author": "sunji621 <sunjin1597532012@163.com>",
  "license": "GPL-3.0",
  "homepage": "https://github.com/sunji621/MSP-Music-Beta",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunji621/MSP-Music-Beta.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.mspmusic.player.beta",
    "productName": "MSPMusic Beta",
    "directories": {
      "output": "release-new"
    },
    "files": [
      "main.js",
      "preload.js",
      "login-preload.js",
      "lan-server.js",
      "index.html",
      "mpv-engine.js",
      "default_cover.png"
    ],
    "extraResources": [
      {
        "from": "bin/mpv",
        "to": "bin/mpv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "MSP Music - local music player (Beta)",
      "maintainer": "MSP Music <msp@local>",
      "artifactName": "MSPMusic-Beta-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "MSP Music Beta",
      "artifactName": "MSPMusic-Beta-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.7.0",
    "iconv-lite": "^0.6.3",
    "jsdom": "^30.0.1",
    "music-metadata": "^10.6.0",
    "opencc-js": "^1.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}